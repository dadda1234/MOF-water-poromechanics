# Hydrated HKUST-1 pressure loading-unloading cycle.
# Run from this directory so the structure and force-field files are found.
# T is the number of water molecules in the reference structure.
# ---------- Initialization and structure selection ----------
variable	T	index	  8 16 24 32

log 		${T}.log.txt
units           real
atom_style      full
boundary        p p p
box tilt        large

read_data       data.water.${T}



# ---------- ReaxFF force field and charge equilibration ----------
pair_style      reax/c NULL checkqeq yes safezone 1.6  mincap 100
pair_coeff      * * CuBTC.ff O Cu C H O H
neigh_modify    every 1 delay 0 check yes    
fix             1 all qeq/reax 1 0.0 10.0 1.0e-6 reax/c




# ---------- Atom groups and timestep settings ----------
group           fram     id   1:4992
variable	DT	equal	0.25
timestep	${DT}
variable	tdamp	equal   ${DT}*100
variable	pdamp	equal   ${DT}*1000


# ---------- Energy minimization and initial velocities ----------
min_style       cg
minimize        1.0e-4  1.0e-8  10000   10000
reset_timestep 0


velocity all create 300 123456

variable p0 equal "press"
variable v0 equal "vol"

fix average all ave/time 20 20 10000 v_p0 v_v0 file ${T}.relax.txt


# ---------- Thermodynamic and trajectory output ----------
thermo_style  custom step temp etotal  press pxx pyy pzz vol lx ly lz
thermo 20000
dump 1 all custom 20000 ${T}.final.lammpstrj  id type x y z




# ---------- NPT equilibration ----------
fix NPT all npt temp 300 300 ${tdamp} aniso 0 0 ${pdamp} 
run 20000
unfix NPT
undump 1
unfix average
reset_timestep 0

# ---------- Data output during loading and unloading ----------
fix average2 all ave/time 20 100 20000 v_p0 v_v0  file ${T}.p-v.txt
dump 2 all custom 20000 ${T}.all1.xyz id type x y z 


# ---------- Pressure loading ----------
fix NPT2 all npt temp 300 300 ${tdamp} aniso 0 8000 ${pdamp}
run 1070000
unfix NPT2


# ---------- Pressure unloading ----------
fix NPT3 all npt temp 300 300 ${tdamp} aniso 8000 0 ${pdamp}
run 1070000
unfix NPT3

unfix average2

# ---------- Next water loading ----------
clear
next T
jump in.water
